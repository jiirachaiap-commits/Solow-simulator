<script>
const $=id=>document.getElementById(id);
const f3=n=>n.toLocaleString('en-US',{minimumFractionDigits:3,maximumFractionDigits:3});
const MINE={s:0.38,d:0.028,a:2.6},SLIDE={s:0.3,d:0.02,a:2.6};
function calc(s,d,A){const K=Math.pow(s*A/d,2),Y=A*Math.sqrt(K);return{K,Y,I:s*Y,D:d*K}}
function get(){return{s:+$('s').value,d:+$('d').value,a:+$('a').value}}
function setV(v){$('s').value=v.s;$('d').value=v.d;$('a').value=v.a;update()}
let aiShown=false;
function nice(x){const p=Math.pow(10,Math.floor(Math.log10(x))),u=p/2;return Math.ceil(x/u)*u}
function chart(s,d,A,r){
 const W=680,H=420,L=64,R=24,T=20,B=52,xm=nice(r.K*1.35),ym=nice(A*Math.sqrt(xm)*1.05);
 const X=k=>L+k/xm*(W-L-R),Y=y=>H-B-y/ym*(H-T-B);
 let g='';
 for(let i=0;i<=5;i++){const kx=xm*i/5,yy=ym*i/5;
  g+=`<line x1="${X(kx)}" x2="${X(kx)}" y1="${T}" y2="${H-B}" stroke="#eee"/><text x="${X(kx)}" y="${H-B+20}" font-size="11" fill="#777" text-anchor="middle">${Math.round(kx).toLocaleString('en-US')}</text>`;
  g+=`<line x1="${L}" x2="${W-R}" y1="${Y(yy)}" y2="${Y(yy)}" stroke="#eee"/><text x="${L-8}" y="${Y(yy)+4}" font-size="11" fill="#777" text-anchor="end">${+yy.toFixed(1)}</text>`}
 const path=fn=>{let p='';for(let i=0;i<=160;i++){const k=xm*i/160;p+=(i?'L':'M')+X(k).toFixed(1)+' '+Y(fn(k)).toFixed(1)}return p};
 g+=`<path d="${path(k=>A*Math.sqrt(k))}" fill="none" stroke="#7c3aed" stroke-width="3.5"/>`;
 g+=`<path d="${path(k=>s*A*Math.sqrt(k))}" fill="none" stroke="#ec4899" stroke-width="3.5"/>`;
 g+=`<path d="${path(k=>d*k)}" fill="none" stroke="#f97316" stroke-width="3.5"/>`;
 g+=`<line x1="${X(r.K)}" x2="${X(r.K)}" y1="${Y(r.I)}" y2="${H-B}" stroke="#0a0a0a" stroke-dasharray="5 5"/>`;
 g+=`<line x1="${L}" x2="${X(r.K)}" y1="${Y(r.I)}" y2="${Y(r.I)}" stroke="#0a0a0a" stroke-dasharray="2 5" opacity=".5"/>`;
 g+=`<circle cx="${X(r.K)}" cy="${Y(r.I)}" r="8" fill="#fff" stroke="#0a0a0a" stroke-width="3"/>`;
 const lx=Math.min(Math.max(X(r.K),L+50),W-R-50);
 g+=`<text x="${lx}" y="${H-B+38}" font-size="12" font-weight="700" text-anchor="middle">K* = ${f3(r.K)}</text>`;
 g+=`<text x="${W-R}" y="${H-6}" font-size="11" fill="#777" text-anchor="end">ทุน K</text><text x="${L}" y="12" font-size="11" fill="#777">ผลผลิต / การลงทุน / ค่าเสื่อม</text>`;
 g+=`<line x1="${L}" x2="${W-R}" y1="${H-B}" y2="${H-B}" stroke="#0a0a0a"/><line x1="${L}" x2="${L}" y1="${T}" y2="${H-B}" stroke="#0a0a0a"/>`;
 $('svg').innerHTML=g}
function setOut(id,v){const e=$(id),t=f3(v);if(e.textContent!==t){e.textContent=t;e.classList.add('flash');setTimeout(()=>e.classList.remove('flash'),350)}}
function update(){
 const{s,d,a}=get(),r=calc(s,d,a);
 $('sv').textContent=f3(s);$('dv').textContent=f3(d);$('av').textContent=f3(a);
 setOut('rK',r.K);setOut('rY',r.Y);setOut('rI',r.I);setOut('rD',r.D);
 chart(s,d,a,r);if(aiShown)ai()}
function ai(){
 aiShown=true;
 const{s,d,a}=get(),b=calc(s,d,a),a2=a*1.2,x=calc(s,d,a2);
 $('bA').textContent=f3(a);$('bK').textContent=f3(b.K);$('bY').textContent=f3(b.Y);
 $('xA').textContent=f3(a2);$('xK').textContent=f3(x.K);$('xY').textContent=f3(x.Y);
 const pc=(n,o)=>{const v=(n/o-1)*100;return(v>=0?'+':'')+f3(v)+'%'};
 $('cK').textContent='K* เปลี่ยนแปลง '+pc(x.K,b.K);$('cY').textContent='Y* เปลี่ยนแปลง '+pc(x.Y,b.Y);
 ['ba','chg','why'].forEach(i=>$(i).classList.remove('hide'))}
['s','d','a'].forEach(i=>$(i).addEventListener('input',update));
$('bTest').onclick=()=>setV(SLIDE);
$('bReset').onclick=()=>setV(MINE);
$('bAI').onclick=ai;
update();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.rv').forEach(e=>io.observe(e));
</script>
</body>
