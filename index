<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Plus+Jakarta+Sans:wght@400;500;700;800&family=Noto+Sans+Thai:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#0a0a0a;--mute:#5d5d66;--line:#e6e4ea;--bg:#fff;--violet:#7c3aed;--pink:#ec4899;--orange:#f97316;--yellow:#fbbf24;
--sans:"Plus Jakarta Sans","Noto Sans Thai",system-ui,sans-serif;--serif:"Instrument Serif","Times New Roman",serif;
box-sizing:border-box;color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.7;-webkit-font-smoothing:antialiased}
.wrap{max-width:1120px;margin:0 auto;padding:0 clamp(20px,5vw,48px)}
h1,h2,h3{line-height:1.08;letter-spacing:-.03em;margin:0;font-weight:800}
em,.it{font-family:var(--serif);font-style:italic;font-weight:400;letter-spacing:-.01em}
.mono{font-variant-numeric:tabular-nums}
/* nav */
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:rgba(255,255,255,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;height:64px}
.logo{font-weight:800;letter-spacing:-.02em;color:var(--ink);text-decoration:none}
.links{display:flex;gap:28px;font-size:.82rem}
.links a{color:var(--ink);text-decoration:none;opacity:.7;transition:opacity .2s}.links a:hover{opacity:1}
.who{font-size:.74rem;border:1px solid var(--ink);border-radius:99px;padding:6px 14px;white-space:nowrap}
/* buttons */
.btn{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--ink);background:transparent;color:var(--ink);border-radius:99px;padding:13px 26px;font:700 .78rem var(--sans);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:background .25s,color .25s,transform .25s,box-shadow .25s}
.btn .ar{transition:transform .25s}
.btn:hover{background:var(--ink);color:#fff;transform:translateY(-2px)}.btn:hover .ar{transform:translateX(5px)}
.btn:focus-visible,input:focus-visible,a:focus-visible{outline:3px solid var(--violet);outline-offset:3px}
.btn.light{border-color:#fff;color:#fff}.btn.light:hover{background:#fff;color:var(--ink)}
.btn.sm{padding:9px 18px;font-size:.7rem}
/* hero */
.hero{position:relative;overflow:hidden;text-align:center;padding:90px 0 40px}
.glow{position:absolute;left:50%;top:330px;width:130%;height:420px;transform:translateX(-50%);z-index:0;filter:blur(70px);background:radial-gradient(ellipse at 20% 55%,var(--violet),transparent 55%),radial-gradient(ellipse at 50% 50%,var(--pink),transparent 55%),radial-gradient(ellipse at 82% 45%,var(--orange),transparent 55%),radial-gradient(ellipse at 95% 70%,var(--yellow),transparent 40%);opacity:.75;animation:drift 14s ease-in-out infinite alternate}
@keyframes drift{to{transform:translateX(-50%) translateY(18px) scale(1.05)}}
.hero .wrap{position:relative;z-index:1}
.hero .tag{font-size:1.5rem;margin-bottom:12px;display:block}
.hero h1{font-size:clamp(2.8rem,8vw,5.6rem)}
.hero p.lead{max-width:600px;margin:26px auto 30px;color:var(--mute)}
.curve{display:block;width:min(760px,100%);margin:34px auto 0}
.curve path{stroke-dasharray:900;stroke-dashoffset:900;animation:draw 2.4s .3s ease forwards}
.curve .p2{animation-delay:.7s}.curve .p3{animation-delay:1.1s}
@keyframes draw{to{stroke-dashoffset:0}}
/* sections */
section{padding:110px 0}
.big{font-size:clamp(2.4rem,6.4vw,4.8rem)}
.intro{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:end}
.intro p{font-size:1.1rem;margin:0}
.formulas{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin:64px 0 48px;border-top:1px solid var(--ink)}
.formulas div{padding:26px 18px 26px 0}
.formulas b{display:block;font-size:1.45rem;letter-spacing:-.02em;margin-bottom:4px}
.formulas span{font-size:.85rem;color:var(--mute)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:56px}
.vars{list-style:none;margin:0;padding:0}
.vars li{display:flex;gap:16px;padding:10px 0;border-bottom:1px solid var(--line)}
.vars b{min-width:34px;font-family:var(--serif);font-style:italic;font-size:1.4rem;font-weight:400}
h3.sub{font-size:1.5rem;margin-bottom:14px}
.ss{margin-top:84px;padding:44px clamp(24px,5vw,56px);border-radius:32px;background:linear-gradient(120deg,#f5eeff,#ffeef6 55%,#fff3e6)}
.drivers{display:grid;grid-template-columns:repeat(3,1fr);gap:44px;margin-top:40px}
.drivers h4{margin:0 0 4px;font-size:1.15rem;letter-spacing:-.01em}
.drivers small{color:var(--mute);display:block;margin-bottom:12px}
.drivers p{margin:0;color:#34343b;font-size:.95rem}
/* simulator */
#simulator{background:linear-gradient(#fff,#fff6fb 60%,#fff)}
.simgrid{display:grid;grid-template-columns:340px 1fr;gap:40px;margin-top:48px;align-items:start}
.ctrl{position:sticky;top:84px;display:grid;gap:26px}
.row label{display:flex;justify-content:space-between;align-items:baseline;font-weight:700;font-size:.92rem}
.row label output{font-size:1.5rem;letter-spacing:-.02em}
input[type=range]{width:100%;margin:12px 0 0;accent-color:var(--pink);height:28px}
.rng{display:flex;justify-content:space-between;font-size:.72rem;color:var(--mute)}
.btns{display:flex;flex-wrap:wrap;gap:10px}
.btn.fill{background:linear-gradient(90deg,var(--violet),var(--pink),var(--orange));border-color:transparent;color:#fff}
.btn.fill:hover{box-shadow:0 10px 26px rgba(236,72,153,.35)}
.chart{background:#fff;border:1px solid var(--line);border-radius:28px;padding:18px 14px 10px}
.chart svg{width:100%;height:auto;display:block}
.legend{display:flex;flex-wrap:wrap;gap:8px 22px;padding:6px 14px 12px;font-size:.82rem}
.legend i{display:inline-block;width:22px;height:4px;border-radius:4px;vertical-align:middle;margin-right:8px}
.res{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:22px;border-top:1px solid var(--ink)}
.res div{padding:18px 12px 6px 0}
.res small{display:block;color:var(--mute);font-size:.78rem;line-height:1.4}
.res b{font-size:clamp(1.15rem,2.2vw,1.55rem);letter-spacing:-.02em;transition:color .3s}
.res b.flash{color:var(--pink)}
.note{font-size:.8rem;color:var(--mute);margin-top:10px}
/* AI */
#ai{position:relative;color:#fff;background:linear-gradient(115deg,#5b1478 0%,#c2188b 38%,#f4475f 68%,#fb923c 100%);overflow:hidden}
#ai .wrap{position:relative}
#ai p{max-width:640px;font-size:1.05rem}
.ba{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:44px 0 24px}
.card{background:rgba(255,255,255,.14);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.35);border-radius:28px;padding:28px}
.card h4{margin:0 0 14px;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase}
.card dl{margin:0;display:grid;gap:10px}
.card dl div{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid rgba(255,255,255,.25);padding-bottom:8px}
.card dt{opacity:.9}.card dd{margin:0;font-weight:700}
.chg{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px}
.chg span{background:#fff;color:var(--ink);border-radius:99px;padding:8px 20px;font-weight:700}
.ba,.chg,.why{transition:opacity .5s,transform .5s}
.hide{opacity:0;transform:translateY(14px);pointer-events:none;height:0;overflow:hidden;margin:0!important}
.why{background:rgba(0,0,0,.28);border-radius:24px;padding:24px 28px;max-width:760px}
.why p{margin:0;font-size:.95rem}
/* footer */
footer{padding:100px 0 48px;position:relative;overflow:hidden}
footer .glow2{position:absolute;left:0;right:0;bottom:-180px;height:320px;filter:blur(70px);opacity:.6;background:linear-gradient(90deg,var(--violet),var(--pink),var(--orange),var(--yellow))}
footer .wrap{position:relative}
footer h2{font-size:clamp(2.2rem,5.4vw,4rem)}
footer p{margin:28px 0 0;font-size:.9rem}
.rv{opacity:0;transform:translateY(22px);transition:opacity .8s,transform .8s}.rv.in{opacity:1;transform:none}
@media(max-width:860px){
.links{display:none}.intro,.cols,.simgrid,.ba{grid-template-columns:1fr}.formulas,.res{grid-template-columns:1fr 1fr}.drivers{grid-template-columns:1fr;gap:30px}
.ctrl{position:static}section{padding:80px 0}.who{font-size:.66rem;padding:5px 10px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}.curve path{stroke-dashoffset:0}}
</style>
</head>
